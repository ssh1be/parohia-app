# Same Supabase project as apps/mobile (EXPO_PUBLIC_SUPABASE_*)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Same key as EXPO_PUBLIC_GOOGLE_CALENDAR_API_KEY (parish Google calendars)
NEXT_PUBLIC_GOOGLE_CALENDAR_API_KEY=

# Public origin used for auth email redirects, e.g. https://parohia.app
NEXT_PUBLIC_SITE_URL=http://localhost:3030

# Optional store link shown to phone visitors on auth/dashboard pages
NEXT_PUBLIC_APP_STORE_URL=
