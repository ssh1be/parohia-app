{
  "name": "parohia",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@parohia/web",
    "dev:mobile": "npm run start --workspace=@parohia/mobile",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@parohia/web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.11.7"
  }
}
